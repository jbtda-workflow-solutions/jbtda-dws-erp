# Environment Variables — Backend

Copy this file to `.env` and fill in your values.
Never commit `.env` to version control.

# ─── Database ───────────────────────────────────────────────────────────────
# Cloud SQL Auth Proxy or direct connection. Include pool limits.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?connection_limit=7&pool_timeout=10"

# ─── Google OAuth 2.0 ───────────────────────────────────────────────────────
# OAuth 2.0 Web Application client ID from GCP Console.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# ─── Session ────────────────────────────────────────────────────────────────
# Minimum 32 cryptographically random bytes (hex-encoded or raw string).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_AT_LEAST_32_CHARS_LONG"

# ─── n8n Webhooks ────────────────────────────────────────────────────────────
# 64-char random hex. Must match WEBHOOK_SECRET configured in n8n.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET="CHANGE_ME_64_CHAR_HEX"

# Base URL of the n8n Cloud Run instance (no trailing slash).
N8N_WEBHOOK_BASE_URL="https://n8n.internal.example.com"

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=8080
HOST="0.0.0.0"

# Origin of the React frontend (for CORS).
FRONTEND_ORIGIN="http://localhost:5173"

